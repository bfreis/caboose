#!/bin/sh
# check-config CONFIG FRAGMENT...: fail when the kernel's final CONFIG
# disagrees with any option a fragment asks for. Kconfig drops what it
# cannot honour without a word -- an option whose dependencies are unmet,
# a name that does not exist, a choice another line overrode -- so after
# merge_config.sh, this is what makes the build say so instead.
#
# A fragment line CONFIG_X=V needs exactly CONFIG_X=V in CONFIG; a line
# "# CONFIG_X is not set" needs CONFIG_X off (not set, or absent: Kconfig
# leaves out an option whose menu is off). Lines starting with ## are
# notes. Each mismatch is printed as FRAGMENT: wanted, got; exit 1 on any.
set -eu

if [ "$#" -lt 2 ]; then
	echo "usage: check-config CONFIG FRAGMENT..." >&2
	exit 2
fi
config=$1
shift
[ -r "$config" ] || { echo "check-config: cannot read $config" >&2; exit 2; }

awk '
FNR == 1 { file++ }
# The final config: one value per option, "n" for is-not-set.
file == 1 {
	if (match($0, /^CONFIG_[A-Za-z0-9_]+=/)) {
		name = substr($0, 1, RLENGTH - 1)
		got[name] = substr($0, RLENGTH + 1)
	} else if ($0 ~ /^# CONFIG_[A-Za-z0-9_]+ is not set$/) {
		got[$2] = "n"
	}
	next
}
# A fragment.
/^##/ || /^[ \t]*$/ { next }
/^# CONFIG_[A-Za-z0-9_]+ is not set$/ {
	name = $2
	if ((name in got) && got[name] != "n") {
		printf "%s: %s off, got %s=%s\n", FILENAME, name, name, got[name]
		bad++
	}
	checked++
	next
}
match($0, /^CONFIG_[A-Za-z0-9_]+=/) {
	name = substr($0, 1, RLENGTH - 1)
	want = substr($0, RLENGTH + 1)
	if (!(name in got) || got[name] == "n") {
		printf "%s: %s=%s, got it off\n", FILENAME, name, want
		bad++
	} else if (got[name] != want) {
		printf "%s: %s=%s, got %s=%s\n", FILENAME, name, want, name, got[name]
		bad++
	}
	checked++
	next
}
{
	printf "%s:%d: not an option line: %s\n", FILENAME, FNR, $0
	bad++
}
END {
	if (bad) {
		printf "check-config: %d of %d options differ from %s\n", bad, checked, ARGV[1]
		exit 1
	}
	printf "check-config: all %d options as asked\n", checked
}
' "$config" "$@"
